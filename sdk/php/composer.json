{
    "name": "kakitu/kakitu-php",
    "description": "PHP SDK for the Kakitu developer API: accept M-Pesa payments settled in KES stablecoin. Request signing is automatic.",
    "type": "library",
    "license": "MIT",
    "keywords": ["kakitu", "mpesa", "kenya", "payments", "stablecoin"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-hash": "*",
        "simplito/elliptic-php": "^1.0.12",
        "kornrunner/keccak": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": { "Kakitu\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Kakitu\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": { "sort-packages": true }
}
